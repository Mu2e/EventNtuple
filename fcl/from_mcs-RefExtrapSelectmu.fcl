#
# Script to tuple reflecting cosmic ray particle candidates selected based on final extrapolation comparisons
# original author: D. Brown, 6/25/26
#
#include "Offline/TrkReco/fcl/prolog.fcl"
#include "Offline/TrkHitReco/fcl/prolog.fcl"
#include "Offline/Mu2eKinKal/fcl/prolog.fcl"
#include "EventNtuple/fcl/from_mcs-mockdata.fcl"
services : @local::Services.Reco
process_name: ENRefExtrapSelect
source : { module_type : RootInput }

physics.producers : {
  TrkQuale : {
    @table::TrkQual
    KalSeedPtrCollection : "SelectReflectmu"
  }

  TrkDtDte : {
    @table::TrkPIDProducers.TrkDtDt
    kalSeeds : [ "SelectReflectmu" ]
  }

  TrkPIDe : {
    @table::TrkPIDProducers.TrkPID
    KalSeeds : [ "SelectReflectmu" ]
    KalSeedDtDts : [ "TrkDtDte:SelectReflectmu" ]

  }

  PBIWeight : @local::PBIWeight
}

physics.RePath : [ PBIWeight, TrkQuale, TrkDtDte, TrkPIDe ]

physics.trigger_paths : [ RePath ]

physics.analyzers : {
  ENRefe : {
    @table::physics.analyzers.EventNtuple
    SelectEvents: [ RePath ]
    trk : {
      @table::EventNtupleMaker.trk
      fillTrkDtDt: true
      fillTrkPID: true
      mc : {
        fill : true
        kalSeedMCAssns: "RegrowKKmu"
      }
      fits : [
        { @table::All
          trkGroupTag : "" # GroupSameTracks is made from MergeKKAll, not this input
          input : "SelectReflectmu"
          trkPIDTags : ["TrkPIDe:SelectReflectmu"]
          trkDtDtTag : "TrkDtDte:SelectReflectmu"
          trkQualLeaves : [ { leafname : "" inputTag : "TrkQuale:ANN" modelVersion : "ANN1_v2.0" } ]
        }
      ]
    }
  }
}

physics.Refe : [ ENRefe ]

physics.end_paths : [ Refe ]
