#include "EventNtuple/fcl/from_mcs-mockdata_noMC.fcl"

physics.EventNtuplePath : [ @sequence::EventNtuple.PathExt ] # path for extracted position cosmics
physics.analyzers.EventNtuple.FillTriggerInfo: true
# trigger results of the event builder process (e.g. to identify calo laser events)
physics.analyzers.EventNtuple.TriggerProcessName : "EvB"
physics.analyzers.EventNtuple.TriggerProcessNameTag : true
physics.analyzers.EventNtuple.FitType : "KinematicLine"
physics.analyzers.EventNtuple.trk.fillTrkDtDt : false
physics.analyzers.EventNtuple.trk.fillHitCalibs : false
# Only the extracted line fit: from_mcs-mockdata.fcl also stores the online tracks and helices, which are not made on this path
physics.analyzers.EventNtuple.trk.fits : [ @local::Ext ]
physics.analyzers.EventNtuple.helices.fill : false
#physics.producers.MergeKKLine.KalSeedCollections: [ "RegrowKL" ]
physics.analyzers.EventNtuple.mc.fill : false

# Time clusters, and the subset that passes CosmicShowerFilter (not used by the line finding). No hit branches: the
# makeSH combo hits they index are not kept in the pass 1 output
physics.analyzers.EventNtuple.timeclusters.fill : true
physics.analyzers.EventNtuple.timeclusters.tags  : [ "SimpleTimeCluster", "CosmicShowerFilter" ]
physics.analyzers.EventNtuple.timeclusters.names  : [ "timeclusters", "showerfilteredtimeclusters" ]
# Line seeds and their hits, for the events with more than one line per time cluster
physics.analyzers.EventNtuple.lineseeds.fill : true
physics.analyzers.EventNtuple.lineseeds.tags  : [ "LineFinder" ]
physics.analyzers.EventNtuple.lineseeds.names  : [ "lineseeds" ]
physics.analyzers.EventNtuple.lineseeds.fillHitsFor : [ "lineseeds" ]

physics.analyzers.EventNtuple.crv.fill : false

# same geometry as the reconstruction (PassN Combined_Pass1.fcl)
services.GeometryService.inputFile : "Offline/Mu2eG4/geom/geom_common_extracted_v06.txt"
physics.analyzers.EventNtuple.crv.fill : true
physics.analyzers.EventNtuple.crv.fillDigis : true
physics.analyzers.EventNtuple.crv.digisTag : "CrvDigi"
physics.analyzers.EventNtuple.crv.coincidencesTag: "CrvCoincidenceClusterFinder"
physics.analyzers.EventNtuple.crv.recoPulsesTag: "CrvRecoPulses"

physics.analyzers.EventNtuple.calo.fill : true
physics.analyzers.EventNtuple.calo.fillDigis : false

# MSD info
physics.analyzers.EventNtuple.msd.fill : true
physics.analyzers.EventNtuple.msd.hitsTag : "MSDHitMaker"
