#
# Script to regrow, make final selection, and tuple reflecting cosmic ray particles starting with the coarse output from Production/JobConfig/reco/RefT0Select.fcl
# original author: D. Brown, 6/25/26
#include "Offline/fcl/minimalMessageService.fcl"
#include "Offline/fcl/standardProducers.fcl"
#include "Offline/fcl/standardServices.fcl"
#include "EventNtuple/fcl/prolog.fcl"
#
#include "Production/JobConfig/recoMC/RefExtrapSelect.fcl"
services : @local::Services.Reco
process_name: ENRefSelect
source : { module_type : RootInput }

physics.producers : {
  @table::physics.producers
  TrkQuale : {
    @table::TrkQual
    KalSeedPtrCollection : "SelectReflecte"
  }

  TrkQualmu : {
    @table::TrkQual
    KalSeedPtrCollection : "SelectReflectmu"
  }

  TrkDtDte : {
    @table::TrkPIDProducers.TrkDtDt
    kalSeeds : [ "SelectReflecte" ]
  }

  TrkDtDtmu : {
    @table::TrkPIDProducers.TrkDtDt
    kalSeeds : [ "SelectReflectmu" ]
  }

  TrkPIDe : {
    @table::TrkPIDProducers.TrkPID
    KalSeeds : [ "SelectReflecte" ]
    KalSeedDtDts : [ "TrkDtDte:SelectReflecte" ]

  }

  TrkPIDmu : {
    @table::TrkPIDProducers.TrkPID
    KalSeeds : [ "SelectReflectmu" ]
    KalSeedDtDts : [ "TrkDtDtmu:SelectReflectmu" ]
  }

  PBIWeight : @local::PBIWeight
}

physics.RePath : [ @sequence::physics.RePath, PBIWeight, TrkQuale, TrkDtDte, TrkPIDe ]
physics.RmuPath : [ @sequence::physics.RmuPath, PBIWeight, TrkQualmu, TrkDtDtmu, TrkPIDmu ]

physics.trigger_paths : [ RePath, RmuPath ]

physics.analyzers : {
  @table::EventNtuple.analyzers
}

physics.analyzers : {
  ENRefe : {
    @table::physics.analyzers.EventNtuple
    SelectEvents: [ RePath ]
    trk : {
      @table::EventNtupleMaker.trk
      fillTrkDtDt: true
      fillTrkPID: true
      mc : {
        fill : true
        kalSeedMCAssns: "RegrowKKe"
      }
      fits : [
        { @table::All
          trkGroupTag : "" # TrackMatchingAll is made from the MergeKKAll inputs, not this input
          input : "SelectReflecte"
          trkPIDTags : ["TrkPIDe:SelectReflecte"]
          trkDtDtTag : "TrkDtDte:SelectReflecte"
          trkQualLeaves : [ { leafname : "" inputTag : "TrkQuale:ANN" modelVersion : "ANN1_v2.0" } ]
        }
      ]
    }
  }

  ENRefmu : {
    @table::physics.analyzers.EventNtuple
    SelectEvents: [ RmuPath ]
    trk : {
      @table::EventNtupleMaker.trk
      fillTrkDtDt: true
      fillTrkPID: true
      mc : {
        fill : true
        kalSeedMCAssns: "RegrowKKmu"
      }
      fits : [
        { @table::All
          trkGroupTag : "" # TrackMatchingAll is made from the MergeKKAll inputs, not this input
          input : "SelectReflectmu"
          trkPIDTags : ["TrkPIDmu:SelectReflectmu"]
          trkDtDtTag : "TrkDtDtmu:SelectReflectmu"
          trkQualLeaves : [ { leafname : "" inputTag : "TrkQualmu:ANN" modelVersion : "ANN1_v2.0" } ]
        }
      ]
    }
  }
}

physics.analyzers.ENRefe.subruns.cosmicLivetime.inputTag : "CosmicResampler:mixed"
physics.analyzers.ENRefmu.subruns.cosmicLivetime.inputTag : "CosmicResampler:mixed"

physics.Refe : [ ENRefe ]
physics.Refmu : [ ENRefmu ]

physics.end_paths : [ Refe, Refmu ]

#update and uncomment to run
#services.DbService.purpose: Sim_best
#services.DbService.version: v1_4
#services.DbService.verbose: 2
