#include "EventNtuple/fcl/from_mcs-mockdata.fcl"

# TODO: the v1.0 and v1.1 trainings pre-date our used of ONNX files
# We will update this file at the next training to show comparison of v2.0 and v3.0

# Compare explicitly named TrackQuality branches.  The v1.0 and v1.1 ONNX
# files must be installed beside the v2 model before running this example.
physics.producers.TrkQualAllV10 : @local::TrkQualAll
physics.producers.TrkQualAllV10.onnxFilename : "ArtAnalysis/TrkDiag/data/TrkQual_ANN1_v1.onnx"

physics.producers.TrkQualAllV11 : @local::TrkQualAll
physics.producers.TrkQualAllV11.onnxFilename : "ArtAnalysis/TrkDiag/data/TrkQual_ANN1_v1.1.onnx"
physics.producers.TrkQualAllV2 : @local::TrkQualAll
physics.producers.TrkQualAllV2.onnxFilename : "ArtAnalysis/TrkDiag/data/TrkQual_ANN1_v2.0.onnx"
physics.EventNtuplePath : [ @sequence::EventNtuple.PathOnline, TrkQualAllV10, TrkQualAllV11, TrkQualAllV2 ]

# Add explicitly named results and record their model versions in the output.
physics.analyzers.EventNtuple.trk.fits[0].mvaTags          : [ "TrkQualAllV10:ANN", "TrkQualAllV11:ANN", "TrkQualAllV2:ANN", "TrkPID:MergeKKAll", "TrkOnlyPID:MergeKKAll" ]
physics.analyzers.EventNtuple.trk.fits[0].mvaBranches      : [ "qual_v1_0",         "qual_v1_1",         "qual_v2_0",        "pid",               "pid_trk" ]
physics.analyzers.EventNtuple.trk.fits[0].mvaModelVersions : [ "TrkQual_ANN1_v1.0", "TrkQual_ANN1_v1.1", "TrkQual_ANN1_v2",  "TrackPID_v1",       "TrkOnlyPID_v0" ]

# Remove hits
physics.analyzers.EventNtuple.trk.fillHits : false
